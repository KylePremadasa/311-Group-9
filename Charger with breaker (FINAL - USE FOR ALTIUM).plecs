".SUBCKT VCCS_EXT_LIM_0_TLV916x VIN+ VIN- IOUT- IOUT+ VP+ VP-\n"
".PARAM GAIN=1\n"
"G1 IOUT+ IOUT- VALUE={LIMIT(GAIN*V(VIN+,VIN-),V(VP-,VIN-),V(VP+,VIN-))}\n"
".ENDS VCCS_EXT_LIM_0_TLV916x\n"
"\n"
".SUBCKT VCCS_LIM_1_0_TLV916x VC+ VC- IOUT+ IOUT-\n"
".PARAM GAIN=1E-4\n"
".PARAM INEG=-.5\n"
".PARAM IPOS=.5\n"
"G1 IOUT+ IOUT- VALUE={LIMIT(GAIN*V(VC+,VC-),INEG,IPOS)}\n"
".ENDS VCCS_LIM_1_0_TLV916x\n"
"\n"
".SUBCKT VCCS_LIM_2_0_TLV916x VC+ VC- IOUT+ IOUT-\n"
".PARAM GAIN=1.26E-1\n"
".PARAM INEG=-5.9\n"
".PARAM IPOS=6.64\n"
"G1 IOUT+ IOUT- VALUE={LIMIT(GAIN*V(VC+,VC-),INEG,IPOS)}\n"
".ENDS VCCS_LIM_2_0_TLV916x\n"
"\n"
".SUBCKT VCCS_LIM_3_0_TLV916x VC+ VC- IOUT+ IOUT-\n"
".PARAM GAIN=1\n"
".PARAM INEG=-70E-3\n"
".PARAM IPOS=100E-3\n"
"G1 IOUT+ IOUT- VALUE={LIMIT(GAIN*V(VC+,VC-),INEG,IPOS)}\n"
".ENDS VCCS_LIM_3_0_TLV916x\n"
"\n"
".SUBCKT VCCS_LIM_4_0_TLV916x VC+ VC- IOUT+ IOUT-\n"
".PARAM GAIN=1\n"
".PARAM INEG=-200E-3\n"
".PARAM IPOS=200E-3\n"
"G1 IOUT+ IOUT- VALUE={LIMIT(GAIN*V(VC+,VC-),INEG,IPOS)}\n"
".ENDS VCCS_LIM_4_0_TLV916x\n"
"\n"
".SUBCKT VCCS_LIM_CLAW+_0_TLV916x VC+ VC- IOUT+ IOUT-\n"
"G1 IOUT+ IOUT- TABLE {(V(VC+,VC-))} =(0, 6.87E-5)(15, 4.04E-4)(30, 7.93E-4)(4"
"5, 1.27E-3)(60, 1.8E-3)(70, 2.4E-3)(80,  3.75E-3)(90, 9.83E-3)\n"
".ENDS VCCS_LIM_CLAW+_0_TLV916x\n"
"\n"
".SUBCKT VCCS_LIM_CLAW-_0_TLV916x VC+ VC- IOUT+ IOUT-\n"
"G1 IOUT+ IOUT- TABLE {(V(VC+,VC-))} =(0, 7.59E-5)(40, 1.21E-3)(60, 2E-3)(70, "
"2.61E-3)(80, 4.42E-3)(90, 9.61E-3)\n"
".ENDS VCCS_LIM_CLAW-_0_TLV916x\n"
"\n"
".SUBCKT VCCS_LIM_GR_0_TLV916x VC+ VC- IOUT+ IOUT-\n"
".PARAM GAIN=1\n"
".PARAM INEG=-12\n"
".PARAM IPOS=14\n"
"G1 IOUT+ IOUT- VALUE={LIMIT(GAIN*V(VC+,VC-),INEG,IPOS)}\n"
".ENDS VCCS_LIM_GR_0_TLV916x\n"
"\n"
".SUBCKT VCCS_LIM_ZO_0_TLV916x VC+ VC- IOUT+ IOUT-\n"
".PARAM GAIN=1\n"
".PARAM INEG=-2E3\n"
".PARAM IPOS=2E3\n"
"G1 IOUT+ IOUT- VALUE={LIMIT(GAIN*V(VC+,VC-),INEG,IPOS)}\n"
".ENDS VCCS_LIM_ZO_0_TLV916x\n"
"\n"
".SUBCKT VCCS_LIMIT_IQ_0_TLV916x VC+ VC- IOUT+ IOUT-\n"
".PARAM GAIN=1E-3\n"
"G1 IOUT- IOUT+ VALUE={IF((V(VC+,VC-)<=0),0,GAIN*V(VC+,VC-))}\n"
".ENDS VCCS_LIMIT_IQ_0_TLV916x\n"
"\n"
".SUBCKT VNSE_0_TLV916x 1 2\n"
".PARAM FLW=10\n"
".PARAM GLF={PWR(FLW,0.25)*NLF/1164}\n"
".PARAM NLF=64.13\n"
".PARAM NVR=4\n"
".PARAM RNV={1.184*PWR(NVR,2)}\n"
".MODEL DVN D (KF={PWR(FLW,0.5)/1E11} IS=1.0E-16)\n"
"D1 7 0 DVN \n"
"D2 8 0 DVN \n"
"E1 3 6 7 8 {GLF}\n"
"E2 6 4 5 0 10\n"
"E3 1 2 3 4 1\n"
"I1 0 7 10E-3\n"
"I2 0 8 10E-3\n"
"R1 3 0 1E9 \n"
"R2 3 0 1E9 \n"
"R3 3 6 1E9 \n"
"R4 5 0 {RNV} \n"
"R5 5 0 {RNV} \n"
"R6 3 4 1E9 \n"
"R7 4 0 1E9 \n"
".ENDS VNSE_0_TLV916x\n"
"\n"
