".PARAM GLFF={PWR(FLWF,0.25)*NLFF/1164}\n"
".PARAM NLFF=60\n"
".PARAM NVRF=60\n"
".PARAM RNVF={1.184*PWR(NVRF,2)}\n"
".MODEL DVNF D (KF={PWR(FLWF,0.5)/1E11} IS=1.0E-16)\n"
"D1 7 0 DVNF \n"
"D2 8 0 DVNF \n"
"E1 3 6 7 8 {GLFF}\n"
"E2 6 4 5 0 10\n"
"G1 1 2 3 4 1E-6\n"
"I1 0 7 10E-3\n"
"I2 0 8 10E-3\n"
"R1 3 0 1E9 \n"
"R2 3 0 1E9 \n"
"R3 3 6 1E9 \n"
"R4 5 0 {RNVF} \n"
"R5 5 0 {RNVF} \n"
"R6 3 4 1E9 \n"
"R7 4 0 1E9 \n"
".ENDS FEMT_0_TLV916x\n"
"\n"
