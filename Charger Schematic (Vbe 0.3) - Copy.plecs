"*******************************************\n"
"*\n"
"*BZT52H-B3V3\n"
"*\n"
"*NXP Semiconductors\n"
"*\n"
"*Single zener diode in a SOD123F package\n"
"*\n"
"*\n"
"*\n"
"*\n"
"*VFmax = 0,9V  @ IF = 10mA  \n"
"*\n"
"*\n"
"*\n"
"*VZmax = 3,37V @ IZ = 5mA\n"
"*\n"
"*\n"
"*\n"
"*\n"
"* \n"
"*\n"
"*\n"
"*Package pinning does not match Spice model pinning.\n"
"*Package: SOD123F\n"
"*\n"
"*Package Pin 1: Cathode\n"
"*Package Pin 2: Anode\n"
"* \n"
"*\n"
"*\n"
"*Extraction date (week/year): 01/2016\n"
"*Simulator: SPICE2\n"
"*\n"
"*******************************************\n"
"*#\n"
".SUBCKT BZT52H-B3V3 1 2     \n"
"R1 1 2 1E+008   \n"
"D1 1 2    DIODE1\n"
"D2 3 1    DIODE2\n"
"VZ 2 3 0.1      \n"
".MODEL DIODE1 D   IS = 3.5E-012   N = 1.4         BV = 3.7        IBV = 0.005"
"     RS = 0.3        CJO = 1.636E-010        VJ = 0.15       M = 0.135       "
"FC = 0.5        TT = 0  EG = 1.1        XTI = 3       \n"
".MODEL DIODE2 D   IS = 1.8E-008   N = 9   RS = 65       \n"
".ENDS        "
        Show          off
      }
